window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
	match is-active=false app-id="^Spotify$"

	opacity 0.84
    background-effect {
        blur true
    }
}

window-rule {
	match app-id="qutebrowser"
	match app-id="firefox"
	match app-id="code"
	default-column-width { proportion 1.0; }
}

window-rule {
    match app-id="^kitty$"
	match app-id="^flowstate$"

    background-effect {
        blur true
    }
}
