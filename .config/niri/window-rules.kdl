window-rule {
	match app-id="qutebrowser"
	match app-id="firefox"
	match app-id="code"
	match app-id="^editor$" 

	open-maximized true
}

window-rule {
    match app-id="^kitty$"
	match app-id="^editor$" 
    background-effect {
        blur true
    }
}

window-rule {
	match is-active=false app-id="^Spotify$"
	opacity 0.84
    background-effect {
        blur true
    }
}

window-rule {
    match is-floating=false
    
    shadow {
        off
    }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    background-effect {
        xray false
    }
}
